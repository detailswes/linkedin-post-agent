# Copy to backend/.env — never commit backend/.env

ENV=development

# MongoDB (local docker-compose or Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=automatic_post_agent

# Hugging Face Space running the CrewAI agents service
AGENT_SERVICE_URL=https://your-user-your-space.hf.space

SESSION_SECRET=change-me-to-a-long-random-string

FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=0

# Optional: topic research (Serper)
SERPER_API_KEY=

# Optional: LinkedIn OAuth
LI_CLIENT_ID=
LI_CLIENT_SECRET=
# LI_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Optional: split frontend/API hosts (production)
# AUTH_COOKIE_SAMESITE=none
